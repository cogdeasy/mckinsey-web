# Ports published by docker compose. Change these when something already listens locally.
POSTGRES_PORT=5432
API_PORT=8000
CONSOLE_PORT=5173
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Object store credentials for the local MinIO instance. Real environments read these from
# the platform secret store, never from a file in the repository.
AWS_ACCESS_KEY_ID=claims-local
AWS_SECRET_ACCESS_KEY=claims-local-secret
